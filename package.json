{
  "name": "@web-hardware/core",
  "version": "1.0.0",
  "description": "The heart of web-hardware — core utilities and primitives for hardware-adjacent web APIs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-hardware/core.git"
  },
  "bugs": {
    "url": "https://github.com/web-hardware/core/issues"
  },
  "homepage": "https://github.com/web-hardware/core#readme",
  "keywords": [
    "web-hardware",
    "hardware",
    "web-api",
    "browser"
  ],
  "author": "web-hardware",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepublishOnly": "pnpm build",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@typescript/typescript6": "^6.0.2",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0"
  }
}
